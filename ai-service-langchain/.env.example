# ============================================
# AI 服务环境变量模板（复制为 .env 并填入真实值）
# 优先级：系统环境变量 > .env > Node 端 ai-config.json
# ============================================

# 主模型（默认 DeepSeek，OpenAI 兼容协议）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# 备用模型（智谱，主模型不可用时自动降级）
FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FALLBACK_API_KEY=your_zhipu_api_key_here
FALLBACK_MODEL=glm-4-flash

# 服务
PORT=8000
AI_SERVICE_TOKEN=请与Node服务配置为相同的至少32位随机字符串
LOG_LEVEL=info

# Node 知识库权威库（Python 直接读该 SQLite；不填则按相对路径猜测，可能指向旧目录）
NODE_SQLITE_PATH=D:/AI应用/AI客服/AI智能客服V3（node.js版）/server/data/service.db
# Node 主服务地址（Agent 工具回调用；DB_TYPE=postgres 时用于拉知识库）
NODE_API_BASE=http://127.0.0.1:3456
