# ===== AI智能客服系统 环境变量配置 =====
# 复制此文件为 .env:  cp .env.example .env
# 生产环境请修改所有密码和密钥

# ---------- AI 大模型配置（标准 OpenAI 兼容，主流方式）----------
# 任意 OpenAI 兼容服务均可接入：DeepSeek / 智谱 / Kimi / 通义 / Ollama 本地等
# 只需改 LLM_BASE_URL + LLM_API_KEY + LLM_MODEL 三行
LLM_PROVIDER=deepseek            # 仅用于日志/展示，可任意命名
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7              # 采样温度 0~2
LLM_TIMEOUT=60                   # 请求超时（秒）

# ---------- 备用模型（可选，主模型不可用时自动降级）----------
# FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# FALLBACK_API_KEY=你的智谱key
# FALLBACK_MODEL=glm-4-flash

# ---------- 旧变量名兼容（已迁移到上方 LLM_* / FALLBACK_*）----------
# DEEPSEEK_API_KEY=sk-your-key-here
# ZHIPU_API_KEY=

# ---------- 数据库 ----------
DB_PASSWORD=请修改为随机密码
AI_SERVICE_TOKEN=请使用至少32位随机字符串
ALLOWED_ORIGINS=https://your-domain.example
# DB_PORT=5432          # 如需修改

# ---------- 服务端口 ----------
# NODE_PORT=3456        # Node 服务端口
# AI_PORT=8000          # AI 服务端口
# NGINX_PORT=80         # Nginx 端口（仅 production profile）

# ---------- 日志 ----------
# LOG_LEVEL=info        # debug / info / warn / error
