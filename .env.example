# ============================================
# AI智能客服系统 - 环境变量配置模板
# 复制此文件为 .env 后修改配置
# cp .env.example .env
# ============================================

# --- 服务配置 ---
NODE_ENV=production
PORT=3456

# --- AI API Keys（推荐！比管理后台更安全）---
# 填写后，管理后台中的 API Key 字段可留空，系统自动优先使用此处的值
ZHIPU_API_KEY=你的智谱AI-ApiKey
DEEPSEEK_API_KEY=你的DeepSeek-ApiKey

# --- 敏感日志加密密钥（生产环境必填！32字符以上）---
# 用于加密存储 sensitive-logs.json 中的聊天原文，泄露后请立即更换
# SENSITIVE_LOG_KEY=your_super_secure_32_char_key_here

# --- CORS 白名单（P1 安全）---
# 生产环境必填，逗号分隔多个域名，留空=开发模式（全放行）
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Docker 部署时使用 ---
# docker compose --env-file .env up -d
