# ============================================
# AI智能客服系统 - Nginx 反向代理配置
# 使用方法：
#   1. 复制到 /etc/nginx/conf.d/ai-customer.conf
#   2. 修改 server_name 为你的域名
#   3. 执行 nginx -t && systemctl reload nginx
#   4. 用 certbot 申请免费SSL证书：
#      certbot --nginx -d yourdomain.com
# ============================================

upstream ai_backend {
    # Docker部署用容器名，直接部署改localhost
    server host.docker.internal:3456;
    keepalive 32;
}

server {
    listen 80;
    server_name yourdomain.com;  # ← 改成你的域名

    # HTTP → HTTPS 重定向（SSL证书申请后自动加）
    # return 301 https://$host$request_uri;

    client_max_body_size 10m;

    location / {
        proxy_pass http://ai_backend;
        proxy_http_version 1.1;

        # WebSocket 支持（客服聊天必须）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时设置（WebSocket长连接需要）
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 健康检查端点（负载均衡器/监控用）
    location /api/health {
        proxy_pass http://ai_backend/api/health;
        access_log off;
    }
}

