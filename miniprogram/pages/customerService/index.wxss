/* pages/customerService/index.wxss */

page {
  background: #f5f6fa;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6fa;
}

/* ===== 导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.nav-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f4fd;
  border: 2rpx solid #2EAADC;
}

.nav-info {
  display: flex;
  flex-direction: column;
}

.nav-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.nav-status {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.nav-status.online { color: #07c160; }
.nav-status.offline { color: #aaa; }

.btn-refresh {
  font-size: 26rpx;
  color: #2EAADC;
  padding: 10rpx 20rpx;
}

/* ===== 消息列表 ===== */
.message-list {
  flex: 1;
  overflow: hidden;
  padding: 20rpx 0;
}

/* 欢迎卡片 */
.welcome-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 30rpx 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.welcome-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f4fd;
  flex-shrink: 0;
}

.welcome-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.welcome-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* 快捷问题 */
.quick-questions {
  margin: 0 30rpx 20rpx;
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  padding: 0 10rpx;
  margin-bottom: 16rpx;
  display: block;
}

.quick-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.quick-item:last-child { border-bottom: none; }
.quick-item:active { background: #f8f9fa; }

.quick-icon { font-size: 28rpx; margin-right: 16rpx; }
.quick-text { flex: 1; font-size: 28rpx; color: #333; }
.quick-arrow { font-size: 32rpx; color: #ccc; }

/* ===== 消息气泡 ===== */
.message-items {
  padding: 10rpx 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-end;
  margin-bottom: 30rpx;
  gap: 16rpx;
}

.user-msg { flex-direction: row-reverse; }

.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.bot-avatar { background: #e8f4fd; border: 2rpx solid #2EAADC; }
.user-avatar { background: #e8f7ee; }

.msg-bubble-wrap {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}

.user-msg .msg-bubble-wrap { align-items: flex-end; }
.bot-msg .msg-bubble-wrap { align-items: flex-start; }

.msg-bubble {
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  word-break: break-all;
}

.bubble-user {
  background: #2EAADC;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.bubble-bot {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.08);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 知识库标签 */
.msg-tag {
  margin-top: 8rpx;
}

.tag-text {
  font-size: 20rpx;
  color: #07c160;
  background: #f0faf4;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 转人工按钮 */
.human-service-btn {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd580;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #fa8c16;
  text-align: center;
}

/* 打字动画 */
.typing-bubble {
  padding: 20rpx 28rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 36rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background: #aaa;
  border-radius: 50%;
  animation: bounce 1.2s infinite ease-in-out;
}

.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== 底部输入栏 ===== */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 16rpx 24rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.send-btn {
  width: 100rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.send-btn.active { background: #2EAADC; }

.send-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== 评价栏 ===== */
.rating-bar {
  padding: 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.rating-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.star {
  font-size: 56rpx;
  color: #ddd;
  transition: color 0.2s;
}

.star.active { color: #faad14; }

.rating-actions {
  display: flex;
  gap: 20rpx;
}

.btn-skip {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

.btn-submit {
  flex: 2;
  height: 80rpx;
  background: #ddd;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-submit.active { background: #2EAADC; }

/* ===== 结束对话 ===== */
.end-bar {
  padding: 10rpx 30rpx;
  background: transparent;
  text-align: center;
}

.btn-end {
  font-size: 24rpx;
  color: #aaa;
  text-decoration: underline;
}
